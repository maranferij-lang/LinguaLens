# Скопіюй цей файл як ".env" і заповни.

# Провайдер розпізнавання: gemini (безкоштовно, для тестів) або anthropic (твій платний ключ, краща якість)
PROVIDER=gemini

# Безкоштовний ключ: https://aistudio.google.com/apikey (картка не потрібна)
GEMINI_API_KEY=

# Платний ключ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Захист публічного сервера (для релізу):
# APP_TOKEN — секрет, який знає лише апка. Згенеруй свій (див. DEPLOY.md) і встав
# ТОЙ САМИЙ рядок у src/api.js -> APP_TOKEN. Локально можна лишити порожнім.
APP_TOKEN=
# Максимум сканів з однієї IP за хвилину
RATE_PER_MIN=20

# Секрет для підпису токенів входу. ОБОВ'ЯЗКОВО задай свій у продакшені —
# якщо змінити, усі користувачі вилетять з акаунтів.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Де зберігати юзерів. Порожньо = локальний файл server/data.json.
# Для Cloud Run встав ID свого Google-проєкту — тоді дані підуть у Firestore.
FIRESTORE_PROJECT=

# PORT=3000
# GEMINI_MODEL=gemini-3.1-flash-lite
# ANTHROPIC_MODEL=claude-haiku-4-5
