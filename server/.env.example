# Скопіюй цей файл як ".env" і заповни:   cp .env.example .env

# Провайдер розпізнавання:
#   mock      — без ключа, завжди «кружка» (щоб прогнати застосунок локально)
#   gemini    — безкоштовний ключ для тестів: https://aistudio.google.com/apikey
#   anthropic — платний ключ, краща якість: https://console.anthropic.com/settings/keys
PROVIDER=mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# ANTHROPIC_MODEL=claude-haiku-4-5

# Секрет підпису токенів пристроїв. ОБОВ'ЯЗКОВО у продакшені; якщо змінити —
# кожен пристрій тихо отримає нову анонімну ідентичність (лічильники скинуться),
# а вхід через Apple більше не знайде старих акаунтів: зв'язок Apple ID →
# словник зберігається під HMAC цим секретом. Після релізу — не чіпати.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Спільний токен застосунку (той самий у EXPO_PUBLIC_APP_TOKEN). Локально можна порожнім.
APP_TOKEN=

# Безкоштовних сканів на ВСЕ ЖИТТЯ запису (анонімний пристрій чи акаунт Apple),
# не на день; за замовчуванням 1. Скани в Pro теж рахуються: Pro скінчився —
# безкоштовного скану вже немає. Стара FREE_SCANS_PER_DAY більше нічого не
# робить: сервер лише пише про неї попередження в лог — прибери її.
FREE_SCANS=1
# Скільки сканів цілої кімнати (сцени) пристрій без Pro має за все життя —
# проба Pro-функції (за замовчуванням 1; 0 — сцени лише в Pro).
# Безкоштовна сцена забирає ще й безкоштовний скан.
FREE_SCENES=1
# Максимум сканів з однієї IP за хвилину
RATE_PER_MIN=20
# Скільки проксі стоїть перед сервером (для справжньої IP).
# Cloud Run напряму — 1. Cloud Run за External Load Balancer — 2.
# TRUST_PROXY_HOPS=1

# RevenueCat (див. USER_TODO.md):
#   секретний REST-ключ (Project settings → API keys → Secret) — сервер сам перевіряє Pro
REVENUECAT_SECRET_KEY=
#   значення заголовка Authorization, яке ти впишеш у налаштуваннях вебхука
REVENUECAT_WEBHOOK_AUTH=
#   ідентифікатор entitlement (Project → Entitlements), за замовчуванням lingualens_pro
# REVENUECAT_ENTITLEMENT=lingualens_pro

# Sign in with Apple (синхронізація словника між телефонами, див. DEPLOY.md, крок 9).
#   aud у identityToken — bundle id застосунку. Кілька значень через кому
#   (напр., якщо колись з'явиться веб-вхід зі своїм Services ID).
# APPLE_AUDIENCES=com.marik.lingualens
#   Ключ Sign in with Apple з порталу розробника. Потрібен, щоб при видаленні
#   акаунта відкликати вхід (вимога App Store). Без цих трьох змінних вхід і
#   синхронізація працюють, але відкликання вимкнене.
#   Team ID — 10 символів: developer.apple.com → Account → Membership details
APPLE_TEAM_ID=
#   Key ID — 10 символів, поруч із ключем у Certificates, Identifiers & Profiles → Keys
APPLE_KEY_ID=
#   Вміст AuthKey_<KEY_ID>.p8 ОДНИМ рядком, переноси — як \n:
#     awk 'NF {printf "%s\\n", $0}' AuthKey_XXXXXXXXXX.p8
#   (у Secret Manager клади сам файл, як є — справжні переноси теж годяться)
APPLE_PRIVATE_KEY=

# Пошта підтримки — з'явиться на сторінках /privacy і /support
SUPPORT_EMAIL=

# Де зберігати дані. Порожньо = локальний файл server/data.json.
# Для Cloud Run встав ID свого Google-проєкту — тоді дані підуть у Firestore.
FIRESTORE_PROJECT=
# Локальний емулятор Firestore замість хмари (тести CI ганяють і на ньому):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8089

# PORT=3000
