# Скопіюй цей файл як ".env" і заповни:   cp .env.example .env

# Провайдер розпізнавання:
#   mock      — без ключа, завжди «кружка» (щоб прогнати застосунок локально)
#   gemini    — безкоштовний ключ для тестів: https://aistudio.google.com/apikey
#   anthropic — платний ключ, краща якість: https://console.anthropic.com/settings/keys
PROVIDER=mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# ANTHROPIC_MODEL=claude-haiku-4-5

# Секрет підпису токенів пристроїв. ОБОВ'ЯЗКОВО у продакшені; якщо змінити —
# кожен пристрій тихо отримає нову анонімну ідентичність (лічильники скинуться).
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Спільний токен застосунку (той самий у EXPO_PUBLIC_APP_TOKEN). Локально можна порожнім.
APP_TOKEN=

# Безкоштовних сканів на день для одного пристрою
FREE_SCANS_PER_DAY=5
# Максимум сканів з однієї IP за хвилину
RATE_PER_MIN=20
# Скільки проксі стоїть перед сервером (для справжньої IP).
# Cloud Run напряму — 1. Cloud Run за External Load Balancer — 2.
# TRUST_PROXY_HOPS=1

# RevenueCat (див. USER_TODO.md):
#   секретний REST-ключ (Project settings → API keys → Secret) — сервер сам перевіряє Pro
REVENUECAT_SECRET_KEY=
#   значення заголовка Authorization, яке ти впишеш у налаштуваннях вебхука
REVENUECAT_WEBHOOK_AUTH=
# REVENUECAT_ENTITLEMENT=pro

# Пошта підтримки — з'явиться на сторінках /privacy і /support
SUPPORT_EMAIL=

# Де зберігати дані. Порожньо = локальний файл server/data.json.
# Для Cloud Run встав ID свого Google-проєкту — тоді дані підуть у Firestore.
FIRESTORE_PROJECT=
# Локальний емулятор Firestore замість хмари (тести CI ганяють і на ньому):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8089

# PORT=3000
