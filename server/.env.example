# Copy this file as ".env" and fill it in.

# Recognition provider: gemini (free, for tests) or anthropic (your paid key, better quality)
PROVIDER=gemini

# Free key: https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=

# Paid key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Protection of the public server (for release):
# APP_TOKEN is a secret known only to the app. Generate your own (see DEPLOY.md) and paste
# THE SAME string into src/api.js -> APP_TOKEN. Locally you can leave it empty.
APP_TOKEN=
# Maximum scans from one IP per minute
RATE_PER_MIN=20

# Secret for signing login tokens. You MUST set your own in production:
# if you change it, all users will be logged out of their accounts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Where to store users. Empty = the local file server/data.json.
# For Cloud Run, paste the ID of your Google project, and then the data goes to Firestore.
FIRESTORE_PROJECT=

# PORT=3000
# GEMINI_MODEL=gemini-3.1-flash-lite
# ANTHROPIC_MODEL=claude-haiku-4-5
