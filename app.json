{
  "expo": {
    "name": "LinguaLens",
    "slug": "lingualens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lingualens",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF8F4",
    "primaryColor": "#5B4FD6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.marik.lingualens",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSPhotoLibraryAddUsageDescription": "LinguaLens saves your stickers and cards to Photos when you tap “Save”.",
        "LSApplicationQueriesSchemes": [
          "instagram-stories",
          "instagram"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.marik.lingualens",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "LinguaLens uses the camera to recognize an object and show what it’s called in the language you’re learning.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B4FD6"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F4",
          "dark": {
            "backgroundColor": "#151412"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "LinguaLens only opens the photo you pick, to put your sticker on it for Stories.",
          "savePhotosPermission": "LinguaLens saves your stickers and cards to Photos when you tap “Save”.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LinguaLens only opens the photo you pick, to put your sticker on it for Stories.",
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "uk",
            "de",
            "es"
          ]
        }
      ],
      "expo-apple-authentication",
      "./plugins/withWidgetLocalizations",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.marik.lingualens",
          "widgets": [
            {
              "name": "WordOfDay",
              "displayName": "Word of the Day",
              "description": "A new word every day, with an example sentence. Tap to reveal the translation.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "MyWords",
              "displayName": "My Words",
              "description": "Your saved words, one at a time, starting with the ones due for review.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "Streak",
              "displayName": "Streak",
              "description": "Your learning streak. The flame grows every day you learn.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      "./plugins/withSceneLifecycle"
    ],
    "locales": {
      "en": "./locales/en.json",
      "uk": "./locales/uk.json",
      "de": "./locales/de.json",
      "es": "./locales/es.json"
    }
  }
}
