{
  "expo": {
    "name": "LinguaLens",
    "slug": "lingualens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lingualens",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF8F4",
    "primaryColor": "#5B4FD6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.marik.lingualens",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.marik.lingualens",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "LinguaLens uses the camera to recognize an object and show what it’s called in the language you’re learning.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B4FD6"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F4",
          "dark": {
            "backgroundColor": "#151412"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "uk",
            "de",
            "es"
          ]
        }
      ]
    ],
    "locales": {
      "en": "./locales/en.json",
      "uk": "./locales/uk.json",
      "de": "./locales/de.json",
      "es": "./locales/es.json"
    }
  }
}
