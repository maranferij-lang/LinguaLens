# Налаштування застосунку. Скопіюй як ".env":   cp .env.example .env
# Expo підставляє змінні EXPO_PUBLIC_* у код під час збірки. Для релізних
# збірок EAS задай їх у EAS: eas env:set (див. USER_TODO.md, крок 7).
# УВАГА: усе з EXPO_PUBLIC_ потрапляє в застосунок — секретних ключів тут бути не може.

# Адреса сервера. Порожньо в розробці = локальний сервер знайдеться сам.
EXPO_PUBLIC_SERVER_URL=

# Той самий рядок, що APP_TOKEN на сервері (можна порожнім)
EXPO_PUBLIC_APP_TOKEN=

# Публічний iOS-ключ RevenueCat. Локально й у середовищах EAS development/preview —
# ключ Test Store (test_…): покупки проходять через симульоване вікно RevenueCat.
# У production — лише ключ App Store (appl_…): production-збірку з тестовим
# ключем або без ключа зупиняє scripts/check-release-env.js.
# Порожньо = покупки імітуються в розробці.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Сторінка політики приватності. Порожньо = <EXPO_PUBLIC_SERVER_URL>/privacy
# (її віддає наш сервер).
EXPO_PUBLIC_PRIVACY_URL=
# Пошта підтримки (необов'язково)
EXPO_PUBLIC_SUPPORT_EMAIL=

# App ID застосунку Meta для кнопки «Instagram Stories» (не секрет).
# Порожньо = кнопки немає, ділитися можна через системне меню.
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Анонімна статистика PostHog: ключ проєкту (phc_…, не секрет — він лише
# приймає події). Порожньо = статистика вимкнена, застосунок нічого не надсилає.
EXPO_PUBLIC_POSTHOG_KEY=
# Сервер PostHog. Порожньо = https://eu.i.posthog.com (європейський).
EXPO_PUBLIC_POSTHOG_HOST=
